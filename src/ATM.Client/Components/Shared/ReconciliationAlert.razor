@if (Visible)
{
    <div class="alert alert-warning"
         role="alert">

        <h2 class="h6">
            Transaction status uncertain
        </h2>

        <p>
            The previous financial operation may have
            been completed, but its result could not
            be confirmed.
        </p>

        @if (CanRetry)
        {
            <p>
                Retry the operation to confirm it. It is
                safe: the operation will not be applied
                twice. Or refresh your balances and review
                your transaction history.
            </p>
        }
        else
        {
            <p>
                Refresh your balances and review your
                transaction history before submitting
                another operation.
            </p>
        }

        @if (CanRetry)
        {
            <button type="button"
                    class="btn btn-dark me-2"
                    disabled="@Disabled"
                    data-testid="retry-pending-button"
                    @onclick="OnRetry">

                Retry operation

            </button>
        }

        <button type="button"
                class="btn btn-outline-dark"
                disabled="@Disabled"
                @onclick="OnRefresh">

            Refresh accounts

        </button>

    </div>
}

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool CanRetry { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public EventCallback OnRetry { get; set; }
}
